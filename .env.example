# FreteBR Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ========== DATABASE ==========
POSTGRES_DB=fretebr
POSTGRES_USER=fretebr_user
POSTGRES_PASSWORD=seu_senha_aqui_minimo_12_caracteres
DATABASE_URL=postgresql://fretebr_user:seu_senha_aqui@db:5432/fretebr

# ========== SECURITY (CRITICAL) ==========
# IMPORTANT: NEVER commit actual SECRET_KEY to version control
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=sua_secret_key_minimo_32_caracteres

# ========== JWT Configuration ==========
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== CORS ==========
# Comma-separated list of allowed origins (NOT "*")
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ========== APPLICATION ==========
ENVIRONMENT=development
DEBUG=false

# ========== VITE (Frontend) ==========
VITE_API_URL=http://localhost:8000

# ========== TWILIO WhatsApp Integration ==========
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_SANDBOX_ENABLED=true

# Optional: For production WhatsApp (after account upgrade)
# TWILIO_WHATSAPP_PRODUCTION_NUMBER=+1234567890
# TWILIO_WHATSAPP_PRODUCTION_ENABLED=false

# Notifications settings
NOTIFICATIONS_ENABLED=true
WHATSAPP_NOTIFICATIONS_ENABLED=true
